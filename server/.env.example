PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Paste your MongoDB Atlas connection URI here locally. Never commit this file.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/goodplate?retryWrites=true&w=majority
# Generate a long random secret, for example with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
COOKIE_NAME=goodplate_token
